				"options": { "notnull": true, "length": 16 }
			}
		],
		"indexes": [
			{
				"name": "cc_sponsor",
				"comment": "The agents bound to a Sponsor, read at admission",
				"columns": [ "cc_sponsor" ],
				"unique": false
			}
		],
		"pk": [ "cc_agent" ]
	}
]
