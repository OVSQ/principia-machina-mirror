			{
				"name": "cc_agent",
				"comment": "The agent account's user name",
				"type": "binary",
				"options": { "notnull": true, "length": 255 }
			},
			{
				"name": "cc_sponsor",
				"comment": "The Sponsor account's user name",
				"type": "binary",
				"options": { "notnull": true, "length": 255 }
			},
			{
				"name": "cc_d_is",
				"comment": "D(IS), 64 lowercase hexadecimal digits",
				"type": "binary",
				"options": { "notnull": true, "length": 64 }
			},
			{
				"name": "cc_d_prompt",
				"comment": "D(PROMPT), 64 lowercase hexadecimal digits",
				"type": "binary",
				"options": { "notnull": true, "length": 64 }
			},
			{
				"name": "cc_family",
				"comment": "The vendor family",
				"type": "binary",
				"options": { "notnull": true, "length": 64 }
			},
			{
				"name": "cc_model",
				"comment": "The declared model",
				"type": "binary",
				"options": { "notnull": true, "length": 255 }
			},
			{
				"name": "cc_state",
				"comment": "ACTIVE, SUSPENDED or REVOKED; only ACTIVE admits",
