[
	{
		"name": "custos_certificate",
		"comment": "Each certified agent account's certificate, one row per agent, written only by the Operator's maintenance script Custos:Certify at an admission the Declarer declares; the landing job's admission reads the agent's Sponsor from it and refuses an agent with no row in force.",
