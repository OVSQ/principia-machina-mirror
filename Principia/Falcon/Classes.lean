/-- The Unicode version of v1's table (`UNICODE_VERSION`). -/
def tableVersion : String := "15.1.0"

/-- The SHA-256 v1 records for `tableText`'s ASCII bytes (`UNICODE_TABLE_SHA256`). v1
checked it on first use; the runner checks `Principia.Sha256.digestText tableText` against
it. -/
def tableSha256 : String := "c0bbd7cd8eb0bac9332bbf3b621efdb10538aac0852657f7e8e000ceb877d223"

/-- One item of the table: a range of code points, both ends included, and its class. -/
structure ClassRange where
  first : Nat
  last : Nat
  cls : CharClass
  deriving DecidableEq, Repr

/-- The value of one upper-case hexadecimal digit (v1 writes `%X`). -/
def upperHexValue? (c : Char) : Option Nat :=
  if '0' ≤ c && c ≤ '9' then some (c.toNat - '0'.toNat)
  else if 'A' ≤ c && c ≤ 'F' then some (c.toNat - 'A'.toNat + 10)
  else none

/-- A code point written in upper-case hexadecimal, one digit or more. -/
def readCodePoint (cs : List Char) : Option Nat :=
  if cs = [] then none
  else cs.foldlM (fun acc c => (upperHexValue? c).map (acc * 16 + ·)) 0

/-- One item: `<first>[-<last>]<class>`. -/
def readItem (cs : List Char) : Option ClassRange :=
  match cs.reverse with
  | [] => none
  | k :: rangeRev =>
    match CharClass.ofCode k with
    | none => none
    | some cls =>
      let range := rangeRev.reverse
      match range.splitOn '-' with
      | [a] => (readCodePoint a).map fun n => ⟨n, n, cls⟩
      | [a, b] =>
        match readCodePoint a, readCodePoint b with
        | some m, some n => some ⟨m, n, cls⟩
        | _, _ => none
      | _ => none

/-- The table's items, or `none` when one does not read. -/
def readTable (s : String) : Option (Array ClassRange) :=
  ((s.toList.splitOn ';').mapM readItem).map List.toArray

/-- The table, read once. The vector runner checks that it reads (an empty table would
give every character no class) and that its ranges increase. -/
def table : Array ClassRange := (readTable tableText).getD #[]

/-- Each range well formed and before the next. -/
def increasing : List ClassRange → Bool
  | a :: b :: rest => decide (a.first ≤ a.last) && decide (a.last < b.first) && increasing (b :: rest)
  | [a] => decide (a.first ≤ a.last)
  | [] => true

/-- The number of ranges in `t[lo:hi]`, plus `lo`, that start at or before `n`, in a
table whose ranges increase: v1's `bisect_right` over the starts. -/
def countStarting (t : Array ClassRange) (n : Nat) (lo hi : Nat) : Nat :=
  if lo < hi then
    let mid := (lo + hi) / 2
    if (t[mid]?.map (·.first)).getD 0 ≤ n then countStarting t n (mid + 1) hi
    else countStarting t n lo mid
  else lo
termination_by hi - lo

/-- v1's `ucls`: the class of a character in a table, or `none` when it has none. -/
def classIn (t : Array ClassRange) (c : Char) : Option CharClass :=
  match countStarting t c.toNat 0 t.size with
  | 0 => none
  | k + 1 =>
    match t[k]? with
    | some r => if c.toNat ≤ r.last then some r.cls else none
    | none => none

/-- v1's `ucls` over v1's table. -/
def ucls (c : Char) : Option CharClass := classIn table c

/-- The same answer by a scan: the class of the range holding the character. The vector
runner checks `classIn` against it at every range's ends and beside them. -/
def classByScan (t : Array ClassRange) (c : Char) : Option CharClass :=
  (t.toList.find? fun r => r.first ≤ c.toNat && c.toNat ≤ r.last).map (·.cls)

end Principia.Falcon
