/-- A hexadecimal numeral's value; `none` when it is empty or holds another character. -/
def hexValue? (s : String) : Option Nat :=
  if s.isEmpty then none
  else s.foldl (fun acc c => acc.bind fun n =>
    if '0' ≤ c && c ≤ '9' then some (16 * n + (c.toNat - '0'.toNat))
    else if 'A' ≤ c && c ≤ 'F' then some (16 * n + (c.toNat - 'A'.toNat + 10))
    else none) (some 0)

/-- One item `A-B` or `A` and its class letter. -/
def readItem? (item : String) : Option (Nat × Nat × Char) := do
  let cls ← item.toList.getLast?
  let rng := String.ofList item.toList.dropLast
  match rng.splitOn "-" with
  | [a] => let n ← hexValue? a; pure (n, n, cls)
  | [a, b] => pure ((← hexValue? a), (← hexValue? b), cls)
  | _ => none

/-- The table read: each range's first and last code point and its class (v1 `_utable`). An
item that does not read is dropped; the bibliography tests check that none is, and that the
ranges increase. -/
def table : List (Nat × Nat × Char) := (utable.splitOn ";").filterMap readItem?

/-- v1 `ucls`: the class of a code point, the range with the greatest start at or below it
when the code point lies in it (v1's `bisect`); `none` for no class. -/
def ucls (c : Char) : Option Char :=
  let n := c.toNat
  match (table.filter fun (a, _, _) => a ≤ n).getLast? with
  | some (_, b, k) => if n ≤ b then some k else none
  | none => none

end Principia.Biblio
