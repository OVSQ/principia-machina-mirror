  {"name": "late and missing", "request": {"scores": [["A", "x", "m1", 80, 1]], "core": ["m1", "p1"], "se_definition": "ITEM-SAMPLING", "se_max": 5, "released": [["A", "2026-10-05"]], "updated": [["p1", "2026-09-30"]]}, "expected": {"rows": [{"model": "A", "config": "x", "composite": null, "composite_text": null, "se2": null, "se": null, "state": "UNLISTED", "reasons": ["MISSING CORE SCORE", "RELEASED AFTER SOURCE UPDATE"]}]}},
  {"name": "late and SE above", "request": {"scores": [["A", "x", "m1", 80, 7]], "core": ["m1"], "se_definition": "ITEM-SAMPLING", "se_max": 5, "released": [["A", "2026-10-05"]], "updated": [["m1", "2026-09-30"]]}, "expected": {"rows": [{"model": "A", "config": "x", "composite": "80", "composite_text": "80.000000", "se2": "49", "se": "7.000000", "state": "UNLISTED", "reasons": ["SE ABOVE SE MAX", "RELEASED AFTER SOURCE UPDATE"]}]}},
  {"name": "decimal scores", "request": {"scores": [["A", "x", "m1", 33.3, 0.25], ["A", "x", "p1", 66.7, 0.5]], "core": ["m1", "p1"], "se_definition": "ITEM-SAMPLING", "se_max": 0.5}, "expected": {"rows": [{"model": "A", "config": "x", "composite": "50", "composite_text": "50.000000", "se2": "5/64", "se": "0.279508", "state": "LISTED", "reasons": []}]}},
