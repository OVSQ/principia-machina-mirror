{"cases": [
  {"name": "one benchmark", "request": {"scores": [["A", "high", "m1", 80, 1.5]], "core": ["m1"], "se_definition": "ITEM-SAMPLING", "se_max": 5}, "expected": {"rows": [{"model": "A", "config": "high", "composite": "80", "composite_text": "80.000000", "se2": "9/4", "se": "1.500000", "state": "LISTED", "reasons": []}]}},
