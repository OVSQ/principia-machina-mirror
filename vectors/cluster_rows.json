  {"name": "an id not a string", "request": {"scores": [["A", 1, "m1", 1, 1]], "core": ["m1"], "se_definition": "ITEM-SAMPLING", "se_max": 5}, "refused": "BAD_ARGUMENT", "detail": "scores"},
