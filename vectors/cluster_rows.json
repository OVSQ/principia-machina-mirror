  {"name": "a release on the update day is not late", "request": {"scores": [["A", "x", "m1", 80, 1]], "core": ["m1"], "se_definition": "ITEM-SAMPLING", "se_max": 5, "released": [["A", "2026-09-30"]], "updated": [["m1", "2026-09-30"]]}, "expected": {"rows": [{"model": "A", "config": "x", "composite": "80", "composite_text": "80.000000", "se2": "1", "se": "1.000000", "state": "LISTED", "reasons": []}]}},
