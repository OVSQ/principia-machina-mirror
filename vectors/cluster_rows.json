  {"name": "SE MAX 0, an SE of 0", "request": {"scores": [["A", "x", "m1", 80, 0]], "core": ["m1"], "se_definition": "ITEM-SAMPLING", "se_max": 0}, "expected": {"rows": [{"model": "A", "config": "x", "composite": "80", "composite_text": "80.000000", "se2": "0", "se": "0.000000", "state": "LISTED", "reasons": []}]}},
