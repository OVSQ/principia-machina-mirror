  {"name": "two rows in order of first component", "request": {"scores": [["B", "x", "m1", 50, 1], ["A", "x", "m1", 60, 1], ["B", "x", "p1", 52, 1], ["A", "x", "p1", 61, 1]], "core": ["m1", "p1"], "se_definition": "ITEM-SAMPLING", "se_max": 5}, "expected": {"rows": [{"model": "B", "config": "x", "composite": "51", "composite_text": "51.000000", "se2": "1/2", "se": "0.707107", "state": "LISTED", "reasons": []}, {"model": "A", "config": "x", "composite": "121/2", "composite_text": "60.500000", "se2": "1/2", "se": "0.707107", "state": "LISTED", "reasons": []}]}},
  {"name": "two configurations of one model", "request": {"scores": [["A", "low", "m1", 50, 1], ["A", "high", "m1", 60, 1]], "core": ["m1"], "se_definition": "ITEM-SAMPLING", "se_max": 5}, "expected": {"rows": [{"model": "A", "config": "low", "composite": "50", "composite_text": "50.000000", "se2": "1", "se": "1.000000", "state": "LISTED", "reasons": []}, {"model": "A", "config": "high", "composite": "60", "composite_text": "60.000000", "se2": "1", "se": "1.000000", "state": "LISTED", "reasons": []}]}},
  {"name": "a missing core score", "request": {"scores": [["A", "x", "m1", 80, 1], ["B", "x", "m1", 70, 1], ["B", "x", "p1", 72, 1]], "core": ["m1", "p1"], "se_definition": "ITEM-SAMPLING", "se_max": 5}, "expected": {"rows": [{"model": "A", "config": "x", "composite": null, "composite_text": null, "se2": null, "se": null, "state": "UNLISTED", "reasons": ["MISSING CORE SCORE"]}, {"model": "B", "config": "x", "composite": "71", "composite_text": "71.000000", "se2": "1/2", "se": "0.707107", "state": "LISTED", "reasons": []}]}},
  {"name": "a score outside the core set is not used", "request": {"scores": [["A", "x", "m1", 80, 1], ["A", "x", "z9", 10, 40], ["A", "x", "p1", 60, 1]], "core": ["m1", "p1"], "se_definition": "ITEM-SAMPLING", "se_max": 5}, "expected": {"rows": [{"model": "A", "config": "x", "composite": "70", "composite_text": "70.000000", "se2": "1/2", "se": "0.707107", "state": "LISTED", "reasons": []}]}},
  {"name": "SE above SE MAX", "request": {"scores": [["A", "x", "m1", 80, 9], ["A", "x", "p1", 70, 8]], "core": ["m1", "p1"], "se_definition": "ITEM-SAMPLING", "se_max": 5}, "expected": {"rows": [{"model": "A", "config": "x", "composite": "75", "composite_text": "75.000000", "se2": "145/4", "se": "6.020797", "state": "UNLISTED", "reasons": ["SE ABOVE SE MAX"]}]}},
  {"name": "SE exactly at SE MAX", "request": {"scores": [["A", "x", "m1", 80, 4], ["A", "x", "p1", 70, 3]], "core": ["m1", "p1"], "se_definition": "ITEM-SAMPLING", "se_max": 2.5}, "expected": {"rows": [{"model": "A", "config": "x", "composite": "75", "composite_text": "75.000000", "se2": "25/4", "se": "2.500000", "state": "LISTED", "reasons": []}]}},
