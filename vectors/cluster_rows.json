  {"name": "a core benchmark not a string", "request": {"scores": [["A", "x", "m1", 1, 1]], "core": [3], "se_definition": "ITEM-SAMPLING", "se_max": 5}, "refused": "BAD_ARGUMENT", "detail": "core"},
