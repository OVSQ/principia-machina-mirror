{
  "meta": {
    "name": "tpc_strike_corpus",
    "version": "0.1.0",
    "conforms_tps": "0.1.0 revision 4",
    "module": "tpc_strike 0.1.0",
    "canon": "bool -> true/false; int -> base-10; float -> printf %.12g; list -> [e,...]",
    "note": "Cross-residence oracle. Every residence (TPC-PY, TPC-PHP) MUST reproduce every 'expect' exactly. Expected values are hand-derived from PMP-TPM STRIKE RULE / TPS 4.4, not generated by the module."
  },
  "cases": [
    {"id": "a_of_r/C/no-tfk", "fn": "a_of_r",
     "input": {"rid": "C", "records": {"A": {"assumptions": ["a1"], "cites": [], "steps": 2}, "B": {"assumptions": ["a2"], "cites": ["A"], "steps": 3}, "C": {"assumptions": ["a1", "a3"], "cites": ["A", "B"], "steps": 1}}, "tfk_assumptions": []},
     "expect": "3"},

    {"id": "a_of_r/C/tfk-a1", "fn": "a_of_r",
     "input": {"rid": "C", "records": {"A": {"assumptions": ["a1"], "cites": [], "steps": 2}, "B": {"assumptions": ["a2"], "cites": ["A"], "steps": 3}, "C": {"assumptions": ["a1", "a3"], "cites": ["A", "B"], "steps": 1}}, "tfk_assumptions": ["a1"]},
     "expect": "2"},

    {"id": "d_of_r/C/no-tfk", "fn": "d_of_r",
     "input": {"rid": "C", "records": {"A": {"assumptions": ["a1"], "cites": [], "steps": 2}, "B": {"assumptions": ["a2"], "cites": ["A"], "steps": 3}, "C": {"assumptions": ["a1", "a3"], "cites": ["A", "B"], "steps": 1}}, "tfk_assumptions": []},
     "expect": "[3,1]"},

    {"id": "d_of_r/B/tfk-a1", "fn": "d_of_r",
     "input": {"rid": "B", "records": {"A": {"assumptions": ["a1"], "cites": [], "steps": 2}, "B": {"assumptions": ["a2"], "cites": ["A"], "steps": 3}, "C": {"assumptions": ["a1", "a3"], "cites": ["A", "B"], "steps": 1}}, "tfk_assumptions": ["a1"]},
     "expect": "[1,3]"},

    {"id": "sr8/two-equal-u/reduced-2", "fn": "sr8_scale_factor",
     "input": {"measurements": [{"x": 10.0, "u": 1.0}, {"x": 12.0, "u": 1.0}]},
     "expect": "1.41421356237"},

    {"id": "sr8/two/consistent-S1", "fn": "sr8_scale_factor",
     "input": {"measurements": [{"x": 10.0, "u": 2.0}, {"x": 10.5, "u": 2.0}]},
     "expect": "1"},

    {"id": "sr8/three/reduced-4", "fn": "sr8_scale_factor",
     "input": {"measurements": [{"x": 10.0, "u": 1.0}, {"x": 14.0, "u": 1.0}, {"x": 12.0, "u": 1.0}]},
     "expect": "2"},

    {"id": "mm/contradicts", "fn": "mm_contradicts",
     "input": {"x1": 10.0, "u1": 1.0, "x2": 14.0, "u2": 1.0, "k": 2.0, "S": 1.0},
     "expect": "true"},

    {"id": "mm/within", "fn": "mm_contradicts",
     "input": {"x1": 10.0, "u1": 1.0, "x2": 12.0, "u2": 1.0, "k": 2.0, "S": 1.0},
     "expect": "false"},

    {"id": "mm/scaling-removes-it", "fn": "mm_contradicts",
     "input": {"x1": 10.0, "u1": 1.0, "x2": 14.0, "u2": 1.0, "k": 2.0, "S": 2.0},
     "expect": "false"},

    {"id": "lm/contradicts", "fn": "lm_contradicts",
     "input": {"x_l": 10.0, "x_m": 13.0, "u_m": 1.0, "k": 2.0, "S": 1.0},
     "expect": "true"},

    {"id": "lm/within", "fn": "lm_contradicts",
     "input": {"x_l": 10.0, "x_m": 11.5, "u_m": 1.0, "k": 2.0, "S": 1.0},
     "expect": "false"},

    {"id": "sr5/r1-closer", "fn": "sr5_order",
     "input": {"d1": [1, 2], "d2": [2, 1]}, "expect": "r1"},

    {"id": "sr5/r2-closer", "fn": "sr5_order",
     "input": {"d1": [2, 3], "d2": [2, 1]}, "expect": "r2"},

    {"id": "sr5/equal-audit", "fn": "sr5_order",
     "input": {"d1": [2, 3], "d2": [2, 3]}, "expect": "AUDIT"},

    {"id": "sr6/nind-overlap", "fn": "sr6_independence_count",
     "input": {"sets": [["a1", "a2"], ["a3"], ["a2", "a4"]]}, "expect": "2"},

    {"id": "sr6/nind-all-disjoint", "fn": "sr6_independence_count",
     "input": {"sets": [["a1"], ["a2"], ["a3"]]}, "expect": "3"},

    {"id": "sr6/nind-same-model-dropped", "fn": "sr6_independence_count",
     "input": {"sets": [["a1"], ["a2"], ["a3"]], "same_model": [false, true, false]}, "expect": "2"},

    {"id": "sr6/audit-reaches-Nx", "fn": "sr6_audit_opens",
     "input": {"n_ind": 2, "n_x": 2}, "expect": "true"},

    {"id": "sr6/audit-below-Nx", "fn": "sr6_audit_opens",
     "input": {"n_ind": 2, "n_x": 3}, "expect": "false"}
  ]
}
