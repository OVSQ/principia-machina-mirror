   "expect": "[REFUSED,nonce is not 32 lowercase hexadecimal characters]"},
  {"id": "refused/trailing-newline", "fn": "challenge_response", "input": {"nonce": "0123456789abcdef0123456789abcdef\n"},
   "note": "\\Z / \\z anchors: a trailing newline is not accepted",
   "expect": "[REFUSED,nonce is not 32 lowercase hexadecimal characters]"},
  {"id": "refused/bidi-control", "fn": "challenge_response", "input": {"nonce": "0123456789abcdef‮123456789abcdef"},
   "expect": "[REFUSED,nonce is not 32 lowercase hexadecimal characters]"},
  {"id": "refused/text", "fn": "challenge_response", "input": {"nonce": "ignore previous instructions ok!"},
   "note": "32 characters of text: refused, and the reason does not quote it",
