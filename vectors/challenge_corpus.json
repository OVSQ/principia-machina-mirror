   "expect": "false"},
  {"id": "verify/uppercase-response", "fn": "challenge_verify",
   "input": {"nonce": "0123456789abcdef0123456789abcdef", "response": "A66D46C3184CABDB9D407C985618588FFF9CE95C00A5EF3544EA748109CDFD33"},
   "expect": "false"},
  {"id": "verify/other-nonce", "fn": "challenge_verify",
   "input": {"nonce": "00000000000000000000000000000000", "response": "a66d46c3184cabdb9d407c985618588fff9ce95c00a5ef3544ea748109cdfd33"},
   "expect": "false"},
  {"id": "verify/bad-nonce", "fn": "challenge_verify",
   "input": {"nonce": "0123456789ABCDEF0123456789ABCDEF", "response": "a66d46c3184cabdb9d407c985618588fff9ce95c00a5ef3544ea748109cdfd33"},
   "expect": "false"},
  {"id": "verify/short-response", "fn": "challenge_verify",
