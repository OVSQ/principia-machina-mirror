  {"id": "response/n1", "fn": "challenge_response", "input": {"nonce": "0123456789abcdef0123456789abcdef"},
   "expect": "[OK,a66d46c3184cabdb9d407c985618588fff9ce95c00a5ef3544ea748109cdfd33]"},
  {"id": "response/fs", "fn": "challenge_response", "input": {"nonce": "ffffffffffffffffffffffffffffffff"},
   "expect": "[OK,82a932b4bcdffdefad9611f15023690af0c5285fdf315ec85d1d8376c958dcb9]"},
  {"id": "refused/uppercase", "fn": "challenge_response", "input": {"nonce": "0123456789ABCDEF0123456789ABCDEF"},
   "expect": "[REFUSED,nonce is not 32 lowercase hexadecimal characters]"},
