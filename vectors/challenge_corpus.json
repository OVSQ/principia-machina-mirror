  {"id": "refused/empty", "fn": "challenge_response", "input": {"nonce": ""},
   "expect": "[REFUSED,nonce is not 32 lowercase hexadecimal characters]"},
  {"id": "refused/not-a-string", "fn": "challenge_response", "input": {"nonce": 12345},
   "expect": "[REFUSED,nonce is not 32 lowercase hexadecimal characters]"},
  {"id": "refused/preimage-too", "fn": "challenge_preimage", "input": {"nonce": "0123456789ABCDEF0123456789ABCDEF"},
   "expect": "[REFUSED,nonce is not 32 lowercase hexadecimal characters]"},
  {"id": "verify/right", "fn": "challenge_verify",
   "input": {"nonce": "0123456789abcdef0123456789abcdef", "response": "a66d46c3184cabdb9d407c985618588fff9ce95c00a5ef3544ea748109cdfd33"},
   "expect": "true"},
  {"id": "verify/one-digit-changed", "fn": "challenge_verify",
